name: Publish JUnit (Jupiter) test report to GitHub Pages

on:
  push:
    branches: ["main"]
  workflow_dispatch:

# Minimum permissions required for Pages deployments
permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Temurin JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      # Run tests and build the Maven Surefire HTML report
      - name: Run tests
        run: mvn -B -DskipTests=false test
      - name: Generate Surefire HTML report
        run: mvn -B surefire-report:report

      # Collect the site into a single folder (Pages will serve these files)
      - name: Prepare site folder
        run: |
          mkdir -p site
          cp -r target/site/* site/
          # Optional: add a simple index redirect to the Surefire report
          if [ -f site/surefire-report.html ]; then
            printf '<meta http-equiv="refresh" content="0; url=surefire-report.html">' > site/index.html
          fi

      # Upload as the Pages artifact
      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: site

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4